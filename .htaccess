# Не сжимать и не трансформировать JS/CSS: в Яндекс.Браузере
# сжатие/переупаковка ответа приводит к «подвисанию» больших бандлов.
# Заголовки безопасности дублируют то, что выставляет api.php.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|mjs|css)$">
    Header set Cache-Control "no-transform"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  <FilesMatch "\.(?:js|mjs|css)$">
    SetEnv no-gzip 1
  </FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
  SetEnvIfNoCase Request_URI \.(?:js|mjs|css)(\?.*)?$ no-brotli
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:js|mjs|css|json|webmanifest|svg|png|ico)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
